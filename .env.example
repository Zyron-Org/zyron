# ==============================================================================
# ZYRON MONOREPO — ROOT ENVIRONMENT VARIABLES REFERENCE
# Copy the relevant sections into `backend/.env`, `zyron-agent/.env`, and `frontend/.env.local`.
# ==============================================================================

# ─── 1. META MODEL API (SERVER-SIDE ONLY: backend/.env & zyron-agent/.env) ───
LLM_PROVIDER="meta"
AI_PROVIDER="meta"
MODEL_API_KEY="YOUR_META_MODEL_API_KEY"
META_API_BASE_URL="https://api.meta.ai/v1"
META_MODEL="muse-spark-1.3"

# ─── 2. MULTICHAIN ATTESTATION REGISTRIES (backend/.env & contracts/.env) ────
DEFAULT_ATTESTATION_CHAIN_ID=10143
MONAD_TESTNET_RPC_URL="https://testnet-rpc.monad.xyz"
MONAD_TESTNET_ATTESTATION_ADDRESS="0xBd24D2BFFbc69a17aCe69aaF930fC4e0d979c4D3"

BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
BASE_SEPOLIA_ATTESTATION_ADDRESS="0xc242125A0b342E045Cf0E1c2e02C95D1EAEEC5c4"

# Relayer operator wallet private key (server-side only; never expose to AI or frontend)
OPERATOR_PRIVATE_KEY=""

# ─── 3. ZYRON AGENT SANDBOX & WEBHOOK AUTH (zyron-agent/.env & backend/.env) ─
ZYRON_AGENT_URL="http://localhost:5001"
AGENT_API_KEY="zyron_agent_internal_secret_key_2026_secure"
CALLBACK_SHARED_SECRET="zyron_callback_hmac_secret_2026"
SANDBOX_MODE="docker"
SANDBOX_IMAGE="zyron-sandbox:latest"

# ─── 4. FRONTEND PUBLIC CONFIG (frontend/.env.local) ─────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_PRIVY_APP_ID=""
