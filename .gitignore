# Root Monorepo Git Ignore

# Dependencies
node_modules/
*/node_modules/
**/node_modules/
.pnpm-store/

# Environment files & Secrets
.env
.env.*
!.env.example
!*/.env.example
*.env
*.env.local

# Build artifacts
dist/
*/dist/
**/dist/
.next/
*/.next/
**/ .next/
out/
*/out/
build/
*/build/
cache/
*/cache/
contracts/out/
contracts/cache/

# Databases & local persistent storage
*.db
*.db-journal
*.sqlite
*.sqlite3
dev.db
*/dev.db
prisma/*.db
prisma/*.db-journal

# Temporary runtime files & logs
logs/
*/logs/
data/
*/data/
uploads/
*/uploads/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.zip
*.tar.gz
*.pdf

# TypeScript
*.tsbuildinfo

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
.gemini/

# Process manager & Reference
ecosystem.config.js
codebase/
